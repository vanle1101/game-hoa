# Enable only for a local next dev process. Production uses guest cookies and Postgres.
LOCAL_DEV_MODE=false
# Only for a loopback-bound Next production preview behind the authenticated
# gateway. Together with LOCAL_DEV_MODE=true, reads the existing local save.
PREVIEW_LOCAL_SAVE=false
DATABASE_URL=
# Canonical public HTTPS origin for production CSRF checks, e.g. https://your-domain.example.
APP_ORIGIN=
# AI adapter: disabled | demo (local testing only) | openai-compatible
AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
CRON_SECRET=
