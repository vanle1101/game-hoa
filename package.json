{
  "name": "life-level",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && npm run worker:build",
    "start": "next start --hostname 127.0.0.1",
    "worker:build": "esbuild worker/index.ts --bundle --platform=node --target=node22 --packages=external --alias:server-only=./worker/server-only-shim.ts --outfile=dist-worker/index.cjs",
    "worker": "node dist-worker/index.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:e2e:full": "playwright test --config=playwright.config.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.468.0",
    "motion": "^14.3.0",
    "next": "^16.0.0",
    "postgres": "^3.4.9",
    "postprocessing": "^6.39.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "three-csg-ts": "^3.2.0",
    "three-stdlib": "2.36.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
